{
  "name": "forge-strategy-pipeline",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "dotenv -e .env.production -e .env -- drizzle-kit generate",
    "db:push": "dotenv -e .env.production -e .env -- drizzle-kit push",
    "db:deploy": "npm run db:generate && dotenv -e .env.production -e .env -- tsx scripts/migrate.ts",
    "db:init": "dotenv -e .env.production -e .env -- tsx scripts/init-db.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "mysql2": "^3.11.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "^7.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
