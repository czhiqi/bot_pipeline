# Copy to .env next to run_bot.py. Never commit .env.

# paper = real prices, simulated fills (default). live = real orders.
MODE=paper
# Second switch for real money. Both MODE=live and ALLOW_LIVE=true are required.
ALLOW_LIVE=false

# Exchange API keys (trade permission only; never enable withdrawals).
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
# Bitget passphrase
EXCHANGE_PASSWORD=
# true = Bitget demo / Binance testnet (if your ccxt version supports it)
EXCHANGE_SANDBOX=false
